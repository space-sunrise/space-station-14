uniform highp float intensity;

void fragment() {
    highp vec2 iResolution = 1.0 / SCREEN_PIXEL_SIZE;
    highp vec2 fragCoord = FRAGCOORD.xy;

    highp vec2 uv = (2.0 * fragCoord - iResolution.xy) / min(iResolution.x, iResolution.y);

    for(highp float i = 1.0; i < 10.0; i++) {
        uv.x += 0.6 / i * cos(i * 2.5 * uv.y + TIME) * intensity;
        uv.y += 0.6 / i * cos(i * 1.5 * uv.x + TIME) * intensity;
    }

    highp vec3 color = vec3(0.1) / abs(sin(TIME - uv.y - uv.x));
    highp float alpha = 0.5 + 0.3 * sin(TIME * 1.5);

    COLOR = vec4(color * intensity, alpha * intensity);
}

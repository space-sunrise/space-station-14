uniform highp vec3 color1;
uniform highp vec3 color2;
uniform highp vec2 texScale;
uniform highp vec2 offset;
uniform highp vec2 size;
uniform highp float rotation;


void fragment() {

    vec2 uv = UV2;
    float rad = radians(rotation);
    vec2 center = vec2(0.5);
    uv -= center;

    float cos_a = cos(rad);
    float sin_a = sin(rad);
    mat2 rot = mat2(
        cos_a, -sin_a,
        sin_a,  cos_a
    );
    uv = rot * uv;
    uv += center;

    highp vec4 base = texture2D(TEXTURE, UV);
    highp vec3 gradient = mix(color2, color1, uv.y * size.y + offset.y);
    // gradient = floor(gradient * texScale.y + 0.5) / texScale.y;
	COLOR = vec4(base.rgb * gradient, base.a);
    // COLOR = vec4(uv.x, uv.y, 0, 1);
}

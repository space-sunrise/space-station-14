ent-XenoReaper = рипер-ксеноборг
    .desc = Гибрид человека и машины, стремящийся к самовоспроизведению. Они обожают извлекать мозги и вставлять их в новые ксеноборговые шасси, чтобы наращивать свою армию. Это тип рипера, скрытный диверсионный отряд, предназначенный для саботажа и убийств.
    .suffix = с мозгом

ent-XenoReaperPrinted = { ent-XenoReaper }
    .suffix = без мозга
    .desc = { ent-XenoReaper.desc }

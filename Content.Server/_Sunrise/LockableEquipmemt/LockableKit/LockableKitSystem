using Robust.Shared.GameStates;
using Robust.Shared.Prototypes;
using Robust.Server.Containers;

namespace Content.Server._Sunrise.LockableEquipment.LockableKit
{
    public sealed class LockableKitSystem : EntitySystem
    {
        [Dependency] private readonly ContainerSystem _container = default!;
        public override void Initialize()
        {
            SubscribeLocalEvent<LockableKitComponent, ComponentStartup>(OnStartup);
        }

        private void OnStartup(Entity<LockableKitComponent> ent, ref ComponentStartup args)
        {
            if (!ent.Comp.AutoLink)
                return;

            if (!_container.TryGetContainer(ent, ent.Comp.ContainerId, out var container))
                return;

            EntityUid? key = null;
            EntityUid? device = null;

            foreach (var item in container.ContainedEntities)
            {
                if (HasComp<KeyComponent>(item))
                    key = item;

                if (HasComp<LockableEquipmentComponent>(item))
                    device = item;
            }

            if (key == null || device == null)
                return;

            Link(key.Value, device.Value);
        }

        private void Link(EntityUid key, EntityUid device)
        {
            var id = Guid.NewGuid().ToString();

            if (TryComp<KeyComponent>(key, out var keyComp))
                keyComp.LockId = id;

            if (TryComp<LockableEquipmentComponent>(device, out var lockComp))
                lockComp.LockId = id;

            Dirty(key);
            Dirty(device);
        }
    }
}

<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'antag-name-eui-window-title'}"
               SetSize="560 230"
               Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="8">
        <Label Name="RoleTitle" StyleClasses="LabelKeyText" HorizontalAlignment="Center" />
        <Label Text="{Loc 'antag-name-eui-prompt'}" />
        <Label Name="CurrentName" StyleClasses="LabelSubText" />
        <LineEdit Name="NameInput" HorizontalExpand="True" PlaceHolder="{Loc 'antag-name-eui-placeholder'}" />
        <Control VerticalExpand="True" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right" SeparationOverride="8" Margin="0 8 0 0">
            <Button Name="RandomButton" Text="{Loc 'antag-name-eui-random'}" MinWidth="150" MinHeight="32" />
            <Button Name="ConfirmButton" Text="{Loc 'antag-name-eui-confirm'}" MinWidth="150" MinHeight="32" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>

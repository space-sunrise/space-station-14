<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'borg-gender-window-title'}"
               MinSize="360 120"
               SetSize="360 120"
               Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="6">
        <Label Text="{Loc 'borg-gender-window-description'}"
               HorizontalAlignment="Center"
               Margin="0 0 0 6" />

        <Label Text="{Loc 'borg-gender-window-gender-label'}"
               Margin="0 0 0 2" />
        <OptionButton Name="GenderOptionButton"
                      HorizontalExpand="True" />
    </BoxContainer>
</DefaultWindow>

<DefaultWindow xmlns="https://spacestation14.io" Title="{Loc 'ghost-target-window-title'}" MinSize="1050 550" SetSize="1050 550">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SizeFlagsStretchRatio="0.4">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8" Margin="0 4">
            <LineEdit Name="SearchBar" PlaceHolder="Поиск" HorizontalExpand="True" />
            <Button Name="GhostnadoButton" Text="{Loc 'ghost-target-window-warp-to-most-followed'}" />
        </BoxContainer>
        <ScrollContainer Name="Scroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="GhostTeleportContainer" Orientation="Vertical">
                <!-- Target buttons get added here by code -->
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>

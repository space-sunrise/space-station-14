<?xml version="1.0" encoding="utf-8"?>
<UIWidget xmlns="https://spacestation14.io"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          x:Class="Content.Client._Sunrise.UserInterface.DualWield.DualWieldIndicator"
          MinWidth="128"
          MinHeight="128"
          Margin="10,10,10,10">

    <PanelContainer Name="IndicatorPanel"
                    PanelOverride="PanelDarkStyle">
        <BoxContainer Orientation="Vertical"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

            <TextureRect Name="FireIcon"
                         Texture="/Textures/_Sunrise/Interface/DualWield/fire_indicator.png"
                         CustomMinimumSize="96,96"
                         ExpandMode="IgnoreSize"
                         StretchMode="Scale"/>

            <Label Name="FireText"
                   Text=" FIRE"
                   HorizontalAlignment="Center"
                   FontSize="14"/>
        </BoxContainer>
    </PanelContainer>
</UIWidget>

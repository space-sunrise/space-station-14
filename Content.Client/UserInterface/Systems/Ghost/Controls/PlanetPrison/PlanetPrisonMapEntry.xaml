<BoxContainer xmlns="https://spacestation14.io"
              Orientation="Vertical">
    <BoxContainer Orientation="Horizontal">
        <Label Name="Title"
               StyleClasses="LabelKeyText"
               HorizontalExpand="True"/>
        <Label Name="VoteCountLabel"
               Visible="False"
               FontColorOverride="#4CAF50"
               Margin="0 0 4 0"/>
        <Label Name="StatusLabel"
               Visible="False"
               FontColorOverride="#2196F3"
               Margin="0 0 8 0"/>
        <Label Name="TimerLabel"
               Visible="False"
               FontColorOverride="#FF6B35"
               Margin="0 0 8 0"/>
    </BoxContainer>
    <PanelContainer StyleClasses="HighDivider" />
    <RichTextLabel Name="Description"
                   Margin="0 4"/>
    <BoxContainer Orientation="Horizontal"
                  Name="PriorityButtons"
                  Margin="0 8 0 0"
                  HorizontalExpand="True">
        <Button Name="NeverButton"
                Text="{Loc 'planet-prison-priority-never'}"
                StyleClasses="ButtonSquare"
                Disabled="True"
                HorizontalExpand="True"
                Margin="0 2 0 0"/>
        <Button Name="LowButton"
                Text="{Loc 'planet-prison-priority-low'}"
                StyleClasses="ButtonSquare"
                HorizontalExpand="True"
                Margin="0 2 0 0"/>
        <Button Name="MediumButton"
                Text="{Loc 'planet-prison-priority-medium'}"
                StyleClasses="ButtonSquare"
                HorizontalExpand="True"
                Margin="0 2 0 0"/>
        <Button Name="HighButton"
                Text="{Loc 'planet-prison-priority-high'}"
                StyleClasses="ButtonSquare"
                HorizontalExpand="True"
                Margin="0 2 0 0"/>
    </BoxContainer>
</BoxContainer>
